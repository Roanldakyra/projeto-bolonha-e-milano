
@startuml
title Bolonha e Milano - Diagrama de Classes - Etapa 6

skinparam classAttributeIconSize 0

class Main {
    +main(args: String[]): void
}

class Menu {
    -scanner: Scanner
    -emExecucao: boolean
    -jogador: Jogador
    -cidade: Cidade
    -mercado: Mercado
    -agricultura: Agricultura
    -governo: Governo
    -construcoes: Construcoes

    +executar(): void
    -exibirOpcoes(): void
    -lerOpcao(): int
    -processarOpcao(opcao: int): void
    -iniciarNovoJogo(): void
    -exibirStatus(): void
    -abrirMercado(): void
    -abrirAgricultura(): void
    -abrirGoverno(): void
    -abrirConstrucoes(): void
    -colher(): void
    -distribuirAlimentos(): void
    -recrutarSoldados(): void
    -construir(): void
    -exibirSobre(): void
}

class Jogador {
    -nome: String
    -titulo: String

    +getNome(): String
    +getTitulo(): String
    +setTitulo(titulo: String): void
}

class Cidade {
    -nome: String
    -anoAtual: int
    -dono: Jogador
    -florins: int
    -terras: int
    -graos: int
    -servos: int
    -taxaImposto: int
    -nivelJustica: String
    -soldados: int
    -construcoes: int

    +getNome(): String
    +getAnoAtual(): int
    +getDono(): Jogador
    +getFlorins(): int
    +getTerras(): int
    +getGraos(): int
    +getServos(): int
    +getTaxaImposto(): int
    +getNivelJustica(): String
    +getSoldados(): int
    +getConstrucoes(): int

    +setTaxaImposto(taxa: int): void
    +setNivelJustica(nivel: String): void

    +avancarAno(): void

    +adicionarFlorins(qtd: int): void
    +removerFlorins(qtd: int): boolean

    +adicionarTerras(qtd: int): void
    +removerTerras(qtd: int): boolean

    +adicionarGraos(qtd: int): void
    +removerGraos(qtd: int): boolean

    +adicionarServos(qtd: int): void
    +removerServos(qtd: int): boolean

    +adicionarSoldados(qtd: int): void
    +removerSoldados(qtd: int): boolean

    +adicionarConstrucoes(qtd: int): void
    +removerConstrucoes(qtd: int): boolean

    +exibirStatus(): void
}

class Mercado {
    -PRECO_GRAO: int
    -PRECO_TERRA: int

    +getPrecoGrao(): int
    +getPrecoTerra(): int

    +comprarGraos(c: Cidade, qtd: int): boolean
    +venderGraos(c: Cidade, qtd: int): boolean
    +comprarTerras(c: Cidade, qtd: int): boolean
    +venderTerras(c: Cidade, qtd: int): boolean
}

class Agricultura {
    -HECTARES_POR_SERVO: int
    -RENDIMENTO_POR_HECTARE: int
    -SERVOS_POR_GRAO: int
    -CRESCIMENTO_PERCENTUAL: int
    -PERCENTUAL_MINIMO: int
    -PERCENTUAL_MAXIMO: int

    +processarColheita(cidade: Cidade): int
    +distribuirAlimentos(cidade: Cidade, percentual: int): boolean
}

class Governo {
    +arrecadarImpostos(cidade: Cidade): int
    +definirTaxaImposto(cidade: Cidade, taxa: int): boolean
    +definirJustica(cidade: Cidade, nivel: String): boolean
    -multiplicadorPara(nivel: String): double
}

class Construcoes {
    -PRECO_SOLDADO: int
    -SERVOS_POR_SOLDADO: int
    -PRECO_CONSTRUCAO: int

    +recrutarSoldados(cidade: Cidade, qtd: int): boolean
    +construir(cidade: Cidade, qtd: int): boolean
    +getPrecoSoldado(): int
    +getPrecoConstrucao(): int
}

Main --> Menu : cria

Menu --> Jogador : utiliza
Menu --> Cidade : utiliza
Menu --> Mercado : utiliza
Menu --> Agricultura : utiliza
Menu --> Governo : utiliza
Menu --> Construcoes : utiliza

Jogador --> Cidade : possui

Mercado ..> Cidade : utiliza
Agricultura ..> Cidade : utiliza
Governo ..> Cidade : utiliza
Construcoes ..> Cidade : utiliza

note bottom of Mercado
  Recebe Cidade como parâmetro.
  Não armazena referência à Cidade.
end note

note bottom of Agricultura
  Recebe Cidade como parâmetro.
  Não armazena referência à Cidade.
end note

note bottom of Governo
  Gerencia impostos e nível de justiça.
  Recebe Cidade como parâmetro.
end note

note bottom of Construcoes
  Gerencia o recrutamento de soldados
  e a construção de edifícios.
  Recebe Cidade como parâmetro.
end note

@enduml
